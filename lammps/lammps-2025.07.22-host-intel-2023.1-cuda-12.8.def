Bootstrap: oras
From: ghcr.io/mat3ra/application-containers-public/almalinux-apptainer-intel-nvhpc:i2023.1-nv25.3-cuda-12.8-0
Stage: devel

%post
    export LAMMPS_VERSION=22Jul2025
    export LAMMPS_PATCH=update6

    if [ -f /.singularity.d/env/91-environment.sh ]; then
        . /.singularity.d/env/91-environment.sh
    fi

    # enable additional repos
    dnf in -y --nogpgcheck https://mirrors.rpmfusion.org/free/el/rpmfusion-free-release-$(rpm -E %rhel).noarch.rpm
    dnf in -y --nogpgcheck https://mirrors.rpmfusion.org/nonfree/el/rpmfusion-nonfree-release-$(rpm -E %rhel).noarch.rpm

    # install lammps specific dependencies
    dnf in -y ffmpeg \
        ffmpeg-devel \
        libjpeg-turbo \
        libjpeg-turbo-devel \
        libpng \
        libpng-devel

    export __INTEL_PRE_CFLAGS="-diag-disable=10441"

    # build lammps
    wget -q https://download.lammps.org/tars/lammps-${LAMMPS_VERSION}_${LAMMPS_PATCH}.tar.gz
    tar -xf lammps-${LAMMPS_VERSION}_${LAMMPS_PATCH}.tar.gz
    rm -f lammps-${LAMMPS_VERSION}_${LAMMPS_PATCH}.tar.gz
    cd lammps-${LAMMPS_VERSION}

    cmake -B _build \
        -C cmake/presets/most.cmake \
        -C cmake/presets/nolib.cmake \
        -C cmake/presets/gpu-cuda.cmake \
        -D CMAKE_BUILD_TYPE="Release" \
        -D BUILD_MPI=yes \
        -D BUILD_OMP=yes \
        -D CMAKE_CXX_STANDARD=17 \
        -D FFT=MKL \
        -D FFTW3_INCLUDE_DIR=${MKLROOT}/include/fftw \
        -D GPU_ARCH=sm_80 \
        -D CMAKE_CUDA_ARCHITECTURES=80 \
        -D KSPACE=yes \
        -D MC=yes \
        -D MOLECULE=yes \
        -D QEQ=yes \
        -D WITH_JPEG=yes \
        -D WITH_PNG=yes \
        -D WITH_FFMPEG=yes \
        -D CMAKE_INSTALL_PREFIX=/opt/lammps-2025.07.22.6 ./cmake

    cmake --build _build -j$(nproc)
    cmake --install _build

#-------------------------------- Final image ---------------------------------#

Bootstrap: oras
From: ghcr.io/mat3ra/application-containers-public/almalinux-apptainer-base:9.7-1

%labels
    Maintainer Mat3ra.com
    Version lammps-2025.07.22.6-host-intel-2023.1-cuda-12.8-0

%help
    LAMMPS 2025.07.22.6 (requires mapping Intel OneAPI 2023.1 and CUDA 12.8 from
    the host)
    Example command:
    mpirun -np 1 apptainer exec --nv <image>.sif lmp -sf gpu -pk gpu 1 -i in.min

%files from devel
    /opt/lammps-2025.07.22.6    /opt/

%environment
    export PATH=/opt/lammps-2025.07.22.6/bin:$PATH

    # enable infiniband when available
    if [ -f /sys/class/infiniband/mlx5_0/ports/1/state ] && \
            grep -q "ACTIVE" /sys/class/infiniband/mlx5_0/ports/1/state; then
        export FI_PROVIDER="verbs"
        export FI_VERBS_IFACE="mlx5_0"
    fi

%post
    # enable additional repos
    dnf in -y --nogpgcheck https://mirrors.rpmfusion.org/free/el/rpmfusion-free-release-$(rpm -E %rhel).noarch.rpm
    dnf in -y --nogpgcheck https://mirrors.rpmfusion.org/nonfree/el/rpmfusion-nonfree-release-$(rpm -E %rhel).noarch.rpm

    # install lammps specific dependencies
    dnf in -y ffmpeg \
        ffmpeg-devel \
        libjpeg-turbo \
        libjpeg-turbo-devel \
        libpng \
        libpng-devel \
        rdma-core \
        libfabric

    # Clean up
    dnf clean all && rm -rf /var/cache/yum && rm -rf /var/cache/dnf
